{
  "manifest_version": 3,
  "name": "Delta",
  "version": "0.1.0",
  "description": "Power-user tools for Claude.ai conversations — copy in multiple formats and branch from here.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "delta@deepanshu.local",
      "strict_min_version": "121.0"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/chat/*"],
      "js": ["vendor/turndown.js", "vendor/turndown-plugin-gfm.js", "loader.js"],
      "css": ["src/styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/*.js"],
      "matches": ["https://claude.ai/*"]
    }
  ]
}
